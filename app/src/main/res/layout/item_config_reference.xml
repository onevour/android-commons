<?xml version="1.0" encoding="utf-8"?>
<!-- one configuration of the reference dialog: target, points per hour, values, battery, use -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/sample_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            style="@style/SampleCardTitle"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/per_hour"
            style="@style/SampleChip"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/values"
        style="@style/SampleCardText"
        android:layout_marginTop="4dp"
        android:textColor="#263238" />

    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:flexWrap="wrap">

        <TextView
            android:id="@+id/battery"
            style="@style/SampleChip" />

        <TextView
            android:id="@+id/use"
            style="@style/SampleChip" />
    </com.google.android.flexbox.FlexboxLayout>
</LinearLayout>
