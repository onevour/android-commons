<?xml version="1.0" encoding="utf-8"?>
<!-- a screen that stamps where the user is now (absen, check-in, register) with LocationCapture.current -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/explanation"
                style="@style/SampleCardText"
                android:layout_marginTop="0dp" />

            <Button
                android:id="@+id/check_in"
                style="@style/SamplePrimaryButton"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Mengambil lokasi GPS..."
                    android:textColor="#37474F" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/result_card"
                style="@style/SampleCard"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:focusable="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/result_title"
                        style="@style/SampleCardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/result_status"
                        style="@style/SampleChip"
                        android:layout_marginEnd="0dp"
                        android:layout_marginBottom="0dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/result"
                    style="@style/SampleCardText"
                    android:layout_marginTop="6dp" />

                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/result_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:flexWrap="wrap">

                    <TextView
                        android:id="@+id/chip_accuracy"
                        style="@style/SampleChip" />

                    <TextView
                        android:id="@+id/chip_fix_time"
                        style="@style/SampleChip" />

                    <TextView
                        android:id="@+id/chip_waited"
                        style="@style/SampleChip" />
                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- where the transaction was stamped: the fix and its accuracy circle -->
        <org.osmdroid.views.MapView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="Peta lokasi transaksi" />
    </LinearLayout>
</LinearLayout>
