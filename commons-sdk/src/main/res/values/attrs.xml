<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="ImageViewRound">
        <attr name="round" format="dimension" />
    </declare-styleable>
    <declare-styleable name="NumberInputTextField">
        <attr name="minValue" format="string" />
        <attr name="maxValue" format="string" />
        <attr name="isDecimal" format="boolean" />
        <attr name="titleText" format="string" />
        <attr name="isShowMax" format="boolean" />
        <attr name="dialogFontFamily" format="reference" />
        <attr name="dialogBackground" format="color|reference" />
        <attr name="dialogTitleColor" format="color" />
        <attr name="dialogTitleTextSize" format="dimension" />
        <attr name="dialogResultColor" format="color" />
        <attr name="dialogResultTextSize" format="dimension" />
        <attr name="dialogKeyTextColor" format="color" />
        <attr name="dialogKeyTextSize" format="dimension" />
        <attr name="dialogKeyBackground" format="color|reference" />
        <attr name="useBottomSheet" format="boolean" />
    </declare-styleable>
</resources>